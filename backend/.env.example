# ══════════════════════════════════════════════════════════════════════════════
# SNACKORA — Backend Environment Configuration Template
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.
# ══════════════════════════════════════════════════════════════════════════════

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ───────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/snackora
# For Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/snackora

# ── JSON Web Token ─────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_256bit_hex_secret
JWT_EXPIRE=7d

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
# Production: https://www.snackora.in

# ── Rate Limiting ──────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ── Admin Seeding ─────────────────────────────────────────────────────────────
# Used ONLY during initial DB seeding via scripts — remove after seeding
ADMIN_REGISTRATION_SECRET=replace_with_a_strong_random_admin_secret

# ── Razorpay Payment Gateway ──────────────────────────────────────────────────
# Get keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_YOUR_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_YOUR_WEBHOOK_SECRET

# ── Email / SMTP ───────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM_NAME=Snackora
EMAIL_FROM_ADDRESS=noreply@snackora.in

# ── Cloudinary Image Storage ──────────────────────────────────────────────────
# Get keys from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=snackora/products

# ── Delivery Provider ─────────────────────────────────────────────────────────
# Options: mock (default), shiprocket
DELIVERY_PROVIDER=mock
SHIPROCKET_EMAIL=your_shiprocket_email
SHIPROCKET_PASSWORD=your_shiprocket_password

# ── Web Push / FCM (future) ───────────────────────────────────────────────────
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# FCM_SERVER_KEY=
